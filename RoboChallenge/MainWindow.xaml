<Window x:Class="RoboChallenge.Visualizer.WpfWorldVisualizer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoboChallenge" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#20242A">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <CheckBox x:Name="ExplorationToggle"
                      Content="Show Exploration Map"
                      IsChecked="False"
                      Margin="5"
                      Foreground="White"
                      VerticalAlignment="Center"/>
            <Button Content="Refresh" Click="RefreshButton_Click" Margin="5" Padding="8,3"/>
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Foreground="White"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#111418">
            <Image x:Name="WorldImage"
                   Stretch="None"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="8"/>
        </ScrollViewer>
    </DockPanel>
</Window>
